{
  "name": "notegen",
  "version": "1.0.1",
  "description": "Windows desktop app for AI-assisted note creation on Xiaohongshu and similar platforms",
  "main": "src/main/index.js",
  "author": "科潮智能",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test test/**/*.test.js",
    "build": "node scripts/build.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wongf.notegen",
    "productName": "AI笔记坊",
    "copyright": "Copyright © 科潮智能",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "prompts/**/*",
      "writers/**/*",
      "templates/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI笔记坊"
    }
  }
}
